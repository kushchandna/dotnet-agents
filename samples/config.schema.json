{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DotnetAgents Configuration",
  "type": "object",
  "required": ["agents", "models", "users", "sessions"],
  "properties": {
    "$schema": { "type": "string" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "modelId"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] },
          "modelId": { "type": "string", "minLength": 1 },
          "systemPrompt": { "type": ["string", "null"] },
          "tools": { "type": "array", "items": { "type": "string" } },
          "skills": { "type": "array", "items": { "type": "string" } },
          "mcpServers": { "type": "array", "items": { "type": "string" } },
          "knowledgeBases": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "provider", "modelName"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "enum": ["openai", "openai-compatible", "ollama"] },
          "modelName": { "type": "string", "minLength": 1 },
          "endpoint": { "type": ["string", "null"] },
          "apiKeyEnvVar": { "type": ["string", "null"], "pattern": "^[A-Z_][A-Z0-9_]*$" }
        },
        "additionalProperties": false
      }
    },
    "users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "displayName"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "sessions": {
      "type": "object",
      "required": ["directory"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "properties": {
        "readFile": {
          "type": "object",
          "required": ["sandboxRoot"],
          "properties": {
            "sandboxRoot": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "httpGet": {
          "type": "object",
          "required": ["allowlist"],
          "properties": {
            "allowlist": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
